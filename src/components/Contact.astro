---
import Logo from './Logo.astro';
import { socials } from '../lib/site';

const remotes = socials.map((s) => ({
  name: s.label,
  target: s.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
  url: s.url,
}));

const icons: Record<string, { viewBox: string; d: string }> = {
  GitHub: {
    viewBox: '0 0 16 16',
    d: 'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z',
  },
  LinkedIn: {
    viewBox: '0 0 24 24',
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  X: {
    viewBox: '0 0 24 24',
    d: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
};
---

<footer id="contact" class="mx-auto max-w-[1160px] border-t border-line px-6 pt-20 md:pt-24">
  <p class="label"><span class="text-eng">$</span> git remote -v</p>

  <ul class="mt-6 border-t border-line">
    {
      remotes.map((r) => (
        <li class="border-b border-line">
          <a
            href={r.url}
            target="_blank"
            rel="noopener"
            class="group -mx-3 grid grid-cols-[1fr_auto] items-center gap-4 rounded-md px-3 py-3.5 transition-colors hover:bg-white/[0.03] sm:grid-cols-[14rem_1fr_auto]"
          >
            <span class="flex items-center gap-4 text-lg">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-ink-2 text-mute ring-1 ring-line transition-all duration-300 group-hover:text-eng group-hover:ring-eng/40 group-hover:shadow-[0_0_24px_-6px_var(--color-eng)]">
                <svg viewBox={icons[r.name].viewBox} class="size-[18px] fill-current" aria-hidden="true">
                  <path d={icons[r.name].d} />
                </svg>
              </span>
              {r.name}
            </span>
            <span class="hidden truncate font-mono text-sm text-faint transition-colors group-hover:text-mute sm:block">
              {r.target}
            </span>
            <span class="font-mono text-sm text-faint transition-all group-hover:translate-x-0.5 group-hover:text-paper">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="flex items-center justify-between gap-4 py-12 text-sm text-faint">
    <p class="flex items-center gap-3">
      <Logo class="h-5 w-auto" />
      © {new Date().getFullYear()} Jesús Vélez Santiago
    </p>
    <a href="#intro" class="font-mono text-xs transition-colors hover:text-paper">back to top ↑</a>
  </div>
</footer>
