---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import { lanes, shortHash } from '../lib/site';

const branches = [
  { name: 'main', href: '/', note: 'home', lane: 'engineering' },
  { name: 'about', href: '/#about', note: 'cat README.md', lane: 'science' },
  { name: 'story', href: '/#log', note: 'git log --graph', lane: 'engineering' },
  { name: 'projects', href: '/#projects', note: 'gh repo list --pinned', lane: 'teaching' },
  { name: 'contact', href: '/#contact', note: 'git remote -v', lane: 'science' },
] as const;

const M = lanes.engineering.x;
const D = lanes.science.x;
const NODE_Y = 22;
---

<Base title="404 · jvelezmagic" noindex>
  <TopBar slot="header" />

  <section class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-3xl flex-col justify-center px-6 py-16">
    <p class="step label" style="--s:0">
      <span class="text-eng">$</span> git checkout <span data-path class="text-paper">/404</span><span
        class="caret"
        aria-hidden="true"></span>
    </p>
    <p class="step mt-3 font-mono text-sm break-all text-[#f47a8b]" style="--s:1">
      error: pathspec '<span data-path>/404</span>' did not match any file(s) known to git
    </p>
    <p class="step mt-1 hidden font-mono text-sm text-mute" style="--s:2" data-hint>
      hint: Did you mean <a data-hint-link class="text-paper underline decoration-line underline-offset-4 hover:decoration-current"></a>?
    </p>

    <h1 class="step mt-10 text-[clamp(2.25rem,7vw,4rem)] leading-[1] font-medium tracking-[-0.04em] text-balance" style="--s:3">
      This page was never committed.
    </h1>
    <p class="step mt-5 max-w-xl text-lg leading-relaxed text-pretty text-mute" style="--s:4">
      The link may be old, or the branch was deleted before it was pushed. Everything that does exist is
      one checkout away:
    </p>

    <div class="step mt-10" style="--s:5">
      <p class="label"><span class="text-eng">$</span> git branch -a</p>
      <ol class="mt-3 font-mono text-sm" aria-label="Pages that exist">
        <li class="relative grid h-11 grid-cols-[76px_1fr] items-center" aria-hidden="true">
          <svg class="absolute inset-y-0 left-0 h-full overflow-visible" width="76">
            <path
              d={`M ${D} ${NODE_Y + 6} C ${D} ${NODE_Y + 18}, ${M} ${NODE_Y + 12}, ${M} 44`}
              fill="none"
              stroke={lanes.science.color}
              stroke-width="2"
              stroke-dasharray="3 4"
            />
            <circle class="detached-ring" cx={D} cy={NODE_Y} r="10" fill="none" stroke={lanes.science.color} stroke-width="1.5" />
            <circle cx={D} cy={NODE_Y} r="5.5" fill="var(--color-ink)" stroke={lanes.science.color} stroke-width="2" stroke-dasharray="3 2.5" />
          </svg>
          <span />
          <span class="truncate text-paper">
            <span class="text-sci">*</span> (HEAD detached at <span data-path>/404</span>)
          </span>
        </li>
        {
          branches.map((b, i) => (
            <li class="relative">
              <svg class="pointer-events-none absolute inset-y-0 left-0 h-full overflow-visible" width="76" aria-hidden="true">
                <line x1={M} x2={M} y1="0" y2={i === branches.length - 1 ? NODE_Y : '100%'} stroke={lanes.engineering.color} stroke-width="2" stroke-opacity="0.5" />
                {b.lane !== 'engineering' && (
                  <path d={`M ${M} ${NODE_Y} C ${M + 10} ${NODE_Y}, ${lanes[b.lane].x} ${NODE_Y - 2}, ${lanes[b.lane].x} ${NODE_Y}`} fill="none" stroke={lanes[b.lane].color} stroke-width="2" />
                )}
                <circle class="node" cx={lanes[b.lane].x} cy={NODE_Y} r="5" fill={lanes[b.lane].color} stroke="var(--color-ink)" stroke-width="3" />
              </svg>
              <a
                href={b.href}
                class="group grid h-11 grid-cols-[76px_1fr] items-center rounded-md transition-colors hover:bg-white/[0.03]"
                style={`--c:${lanes[b.lane].color}`}
              >
                <span />
                <span class="flex min-w-0 items-baseline gap-3">
                  <span class="text-paper transition-colors group-hover:text-(--c)">{b.name}</span>
                  <span class="hidden text-faint sm:inline">{shortHash(b.name)}</span>
                  <span class="truncate text-mute">{b.note}</span>
                  <span class="ml-auto pr-3 text-faint opacity-0 transition-all group-hover:translate-x-0.5 group-hover:text-paper group-hover:opacity-100">
                    →
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="step mt-10 flex flex-wrap items-center gap-3" style="--s:6">
      <a href="/" class="rounded-full bg-paper px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-white">
        git checkout main
      </a>
      <a href="/#log" class="rounded-full px-4 py-2 font-mono text-sm text-mute ring-1 ring-line transition-colors hover:text-paper hover:ring-faint">
        read the story ↓
      </a>
    </div>
  </section>
</Base>

<style>
  .step {
    animation: step-in 0.6s var(--ease-out-expo) both;
    animation-delay: calc(0.35s + var(--s) * 0.09s);
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--color-eng);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .detached-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 0.6;
    }
    70%,
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .caret,
    .detached-ring {
      animation: none;
    }
  }
</style>

<script>
  const path = decodeURI(location.pathname);
  document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = path));

  const targets: Record<string, string> = {
    about: '/#about',
    story: '/#log',
    log: '/#log',
    projects: '/#projects',
    project: '/#projects',
    contact: '/#contact',
    blog: '/#log',
    cv: '/#contact',
  };
  const distance = (a: string, b: string) => {
    const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
    for (let j = 1; j <= b.length; j++) d[0][j] = j;
    for (let i = 1; i <= a.length; i++) {
      for (let j = 1; j <= b.length; j++) {
        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
        if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
      }
    }
    return d[a.length][b.length];
  };
  const word = path.toLowerCase().split('/').filter(Boolean)[0] ?? '';
  const best = Object.keys(targets)
    .map((t) => ({ t, d: distance(word, t) }))
    .sort((x, y) => x.d - y.d)[0];
  if (word && best && best.d <= Math.max(1, Math.floor(best.t.length / 3))) {
    const hint = document.querySelector<HTMLElement>('[data-hint]')!;
    const link = hint.querySelector<HTMLAnchorElement>('[data-hint-link]')!;
    link.href = targets[best.t];
    link.textContent = `'${best.t}'`;
    hint.classList.remove('hidden');
  }
</script>
